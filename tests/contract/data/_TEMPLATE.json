{
  "route": "/api/<name>",
  "handler": "netlify/functions/<name>.ts",
  "netlifyRouting": "netlify.toml:12-15 rewrites /api/* -> /.netlify/functions/:splat (status 200)",
  "methods": ["POST"],
  "methodHandling": { "otherMethods": "exact behaviour for any other method (status + body), or 'not checked: falls through to ...'", "cite": "file:line" },
  "auth": { "kind": "requireUser | requireAdmin | none | custom", "cite": "file:line", "notes": "ordering vs. method check / body parse" },
  "query": [
    { "name": "x", "type": "string", "required": true, "parse": "how parsed (Number(), parseInt, regex)", "default": null, "bounds": null, "invalidBehaviour": "...", "cite": "file:line" }
  ],
  "request": {
    "contentType": "application/json | multipart/form-data | none",
    "parse": "how the body is read and what a malformed/empty body does (exact status/body)",
    "fields": [
      { "name": "x", "type": "string", "required": true, "default": null, "bounds": "e.g. 1..12, <=4MB", "validation": "exact check", "cite": "file:line" }
    ],
    "unknownFields": "ignored | forwarded verbatim | rejected (exact)"
  },
  "checkOrder": ["1. auth", "2. ..."],
  "responses": [
    { "status": 200, "contentType": "application/json", "headers": { "cache-control": "..." }, "when": "...", "bodyShape": {}, "example": {}, "cite": "file:line" }
  ],
  "errors": [
    { "status": 400, "body": { "error": "exact message" }, "when": "...", "cite": "file:line" }
  ],
  "sideEffects": ["DB writes, blob writes, background triggers, counters"],
  "externalCalls": ["paid API / upstream service calls, env vars they need"],
  "quirks": ["anything a reimplementation would get wrong"],
  "beforeAnyState": "behaviour when the job/deck/brand/blob does not exist yet",
  "tests": [ { "file": "netlify/functions/_tests/x.test.ts", "asserts": "what it pins" } ],
  "callers": [ { "who": "frontend | Auxi_Connector | Supabase Auth (OIDC) | none", "where": "file:line", "expects": "shape/status the caller relies on" } ],
  "docs": { "openapi": "public/openapi.yaml:line - matches | discrepancies list | absent", "postman": "docs/postman_collection.json - matches | discrepancies | absent", "apiMd": "docs/api.md:line (optional)" },
  "planSection65": "row text from DETAILED-PLAN.md §6.5 and whether it is accurate; list corrections"
}
