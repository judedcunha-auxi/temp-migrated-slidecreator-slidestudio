# Every environment variable the SlideForge service reads, with placeholders only.
# Copy to .env for local development (.env is gitignored). Never put a real secret
# here. tests/config/test_env_example.py fails the build if the code reads a
# variable that is not listed below.
#
# check_config() (app/config/settings.py) validates these at startup; in a
# production-like environment the values marked "required in production" must be set.

# Which rules check_config() applies: development | local | test | staging | production.
# Set it explicitly in every deployed environment.
ENVIRONMENT=development

# Log level for the app's own loggers (DEBUG, INFO, WARNING, ERROR). Default INFO.
LOG_LEVEL=INFO

# Redis: queue, in-flight limiter, counters. Required in production, and must be
# rediss:// (TLS) there, e.g. rediss://:<password>@<name>.redis.cache.windows.net:6380/0
REDIS_URL=redis://127.0.0.1:6379/0
# RESP protocol: 3 (Redis 6+), or 2 for old local builds.
REDIS_PROTOCOL=3

# The static frontend origin(s) allowed to call the API from a browser, comma
# separated. Required in production (https only). Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The header the gateway sends the request id in. Echoed on every response.
REQUEST_ID_HEADER=X-Request-ID

# Application Insights. Empty disables telemetry export (local runs and CI).
# Required in production.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# 1 turns on the exporter's own diagnostic logging. Leave unset normally.
SLIDEFORGE_TELEMETRY_DEBUG=

# Durable storage: fake (in memory) | local (files under SCRATCH_ROOT) | general
# (the General service). Production requires general; check_config refuses fake
# and local there. The general adapter is a stub until the General service repo
# exists (decision D5), so general keeps /readyz at 503 for now.
STORAGE_BACKEND=fake
# The General service base URL. Required (https) when STORAGE_BACKEND=general.
GENERAL_SERVICE_URL=
# Absolute directory for job workspaces and the local storage adapter. Nothing is
# written outside it. Empty uses <system temp>/slideforge-scratch.
SCRATCH_ROOT=

# Set by the platform, not by you (listed so every read is documented):
# WEBSITE_INSTANCE_ID=   App Service instance id; used in log lines, and as a
#                        production signal when ENVIRONMENT is unset.
# HOSTNAME=              Container host name; the instance id off App Service.
