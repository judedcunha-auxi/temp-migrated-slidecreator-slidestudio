# Every environment variable the SlideForge service reads, with placeholders only.
# Copy to .env for local development (.env is gitignored). Never put a real secret
# here. tests/config/test_env_example.py fails the build if the code reads a
# variable that is not listed below.
#
# check_config() (app/config/settings.py) validates these at startup; in a
# production-like environment the values marked "required in production" must be set.

# Which rules check_config() applies: development | local | test | staging | production.
# Set it explicitly in every deployed environment.
ENVIRONMENT=development

# Log level for the app's own loggers (DEBUG, INFO, WARNING, ERROR). Default INFO.
LOG_LEVEL=INFO

# Redis: queue, in-flight limiter, counters. Required in production, and must be
# rediss:// (TLS) there, e.g. rediss://:<password>@<name>.redis.cache.windows.net:6380/0
REDIS_URL=redis://127.0.0.1:6379/0
# RESP protocol: 3 (Redis 6+), or 2 for old local builds.
REDIS_PROTOCOL=3

# The static frontend origin(s) allowed to call the API from a browser, comma
# separated. Required in production (https only). Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The header the gateway sends the request id in. Echoed on every response.
REQUEST_ID_HEADER=X-Request-ID

# Application Insights. Empty disables telemetry export (local runs and CI).
# Required in production.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# 1 turns on the exporter's own diagnostic logging. Leave unset normally.
SLIDEFORGE_TELEMETRY_DEBUG=

# Durable storage: fake (in memory) | local (files under SCRATCH_ROOT) | general
# (the General service). Production requires general; check_config refuses fake
# and local there. The general adapter is a stub until the General service repo
# exists (decision D5), so general keeps /readyz at 503 for now.
STORAGE_BACKEND=fake
# The General service base URL. Required (https) when STORAGE_BACKEND=general.
GENERAL_SERVICE_URL=
# Absolute directory for job workspaces and the local storage adapter. Nothing is
# written outside it. Empty uses <system temp>/slideforge-scratch.
SCRATCH_ROOT=

# --- The AI features (app/config/ai.py) ----------------------------------------------
# Provider keys. ANTHROPIC_API_KEY is required in production (Claude is the primary provider).
# Never commit a real key; in Azure these come from Key Vault references (D18).
ANTHROPIC_API_KEY=
# Gemini is behind a flag and off by default. With LLM_GEMINI_ENABLED=true a Gemini model may
# be chosen, and GEMINI_API_KEY is then required in production.
GEMINI_API_KEY=
LLM_GEMINI_ENABLED=false
# Seconds one provider request may take (a high-effort design round thinks for minutes).
LLM_REQUEST_TIMEOUT_S=900
# The Claude API's server-side refusal fallback (fallbacks: "default") on the models that take it.
LLM_FALLBACKS_ENABLED=true
# Model ids from app/core/llm/registry.py: the design chat, the independent critic (Claude only),
# and the optional brand role annotation during brand extraction (empty: no annotation).
LLM_DESIGN_MODEL=claude-opus-5-5
LLM_CRITIC_MODEL=claude-sonnet-5-5
LLM_BRAND_ROLE_MODEL=
# Effort (low | medium | high | xhigh | max) for design turns and for the critic.
LLM_DESIGN_EFFORT=high
LLM_CRITIC_EFFORT=low
# Output cap per round (1024-128000), rounds per turn (1-100), and how many times a turn may
# continue after hitting max_tokens (0-10; each continuation is a paid round).
LLM_MAX_TOKENS=64000
LLM_MAX_ROUNDS=40
LLM_MAX_CONTINUATIONS=3
# Replace a model's prices (USD per million tokens) without a release. JSON, e.g.
# {"claude-opus-5-5": {"input": 4, "output": 20, "cache_read": 0.2, "cache_write": 5}}
LLM_PRICING_OVERRIDES=
# The design loop: the independent critic behind preview_slide, and the per-slide design brief.
DESIGN_CRITIC_ENABLED=true
DESIGN_BRIEF_ENABLED=true
# Slides parallel Generate designs at once (1-16), and browsers for previews and the design
# review (1-8; one Chromium each, size to memory).
DESIGN_GENERATE_FANOUT=4
DESIGN_PREVIEW_BROWSERS=2
# Reference data. DESIGN_ARCHETYPES_PATH empty: the shared app/data/archetypes.json (also read by
# the storyline). DESIGN_EXEMPLARS_DIR: exemplar pictures are blocked by decision D3 and none ship
# in the repo; empty means none are installed and get_exemplars is not offered.
DESIGN_ARCHETYPES_PATH=
DESIGN_EXEMPLARS_DIR=
# The $0 path: save a hand-authored slide instead of calling a model (wiring checks on staging).
# Refused in production.
DESIGN_STUB=false

# Set by the platform, not by you (listed so every read is documented):
# WEBSITE_INSTANCE_ID=   App Service instance id; used in log lines, and as a
#                        production signal when ENVIRONMENT is unset.
# HOSTNAME=              Container host name; the instance id off App Service.

# --- The export engine (app/config/engine.py). Every variable is SLIDE_ENGINE_<NAME>. ---
# The external PptxRender HTTP service (decision D3b): renders layout backgrounds at master
# import. Required in production (https). Empty means no renderer: import says so, nothing falls back.
SLIDE_ENGINE_RENDERER_URL=
# Seconds before a renderer call counts as hung.
SLIDE_ENGINE_RENDERER_TIMEOUT_S=300
# Which PptxRender endpoints the configured service serves, comma separated:
# render-layouts (the deployed service), render, verify (local builds only; the visual gate).
SLIDE_ENGINE_RENDERER_ENDPOINTS=render-layouts
# What the measuring browser may fetch from other hosts: block (default; required in
# production) or raster (trusted machines only).
SLIDE_ENGINE_REMOTE_RESOURCES=block
# Playwright browser: chromium (the bundled build; the container) or an installed channel (msedge).
SLIDE_ENGINE_BROWSER_CHANNEL=chromium
# Engine threads, one Chromium each (app/core/browser_pool.py), 1-16. Size to memory.
SLIDE_ENGINE_BROWSER_POOL_SIZE=1
# Font folders to scan, separated by the OS path separator. Empty: the platform's default folders.
SLIDE_ENGINE_FONT_DIRS=
# Optional OOXML validator (validate.py with its schemas/). Empty: the suite skips that check.
SLIDE_ENGINE_VALIDATE_PY=
# Torture fixtures and synthetic test masters (tests/CI). Empty: tests/engine/fixtures.
SLIDE_ENGINE_FIXTURES_DIR=
# Text fitting: share of a predicted over-width closed with letter spacing (0-1), and the slack
# added to a measured text box width (1-1.2).
SLIDE_ENGINE_WIDTH_LOCK_FACTOR=1.0
SLIDE_ENGINE_TEXT_BOX_WIDTH_SLACK=1.02
# The visual gate's thresholds (pinned to PptxRender's defaults; changing one makes recorded
# numbers incomparable) and its non-chart defect-area target at 1280x720 (0 disables it).
SLIDE_ENGINE_GATE_BLUR=2.0
SLIDE_ENGINE_GATE_DELTA_E=8.0
SLIDE_ENGINE_GATE_MIN_AREA=60
SLIDE_ENGINE_GATE_SLACK=2
SLIDE_ENGINE_GATE_TARGET_PX2_1280=6000
# Side-by-side text checks: row overlap share, position and alignment tolerances (px).
SLIDE_ENGINE_TEXT_ROW_SHARE=0.5
SLIDE_ENGINE_TEXT_POSITION_TOL_PX=1.5
SLIDE_ENGINE_TEXT_ALIGN_TOL_PX=1.5

# Set by Windows, read only to find its font folders (app/config/engine.py):
# SystemRoot=
# LOCALAPPDATA=

# --- The storyline and intake (app/config/storyline.py). Every variable is STORYLINE_<NAME>. ---
# The model for the storyline draft and the intake turn. Same variable name as Darwin's Netlify
# functions; the default moved from claude-sonnet-4-6 to claude-sonnet-5-5.
STORYLINE_MODEL=claude-sonnet-5-5
# Output budget for one storyline draft (thinking counts against it), 1-128000.
STORYLINE_MAX_TOKENS=64000
# How hard the model thinks on the storyline: low | medium | high | xhigh | max.
STORYLINE_EFFORT=high
# Output budget and effort for one intake turn.
STORYLINE_INTAKE_MAX_TOKENS=4096
STORYLINE_INTAKE_EFFORT=low
# The intake wraps up without a model call after this many assistant replies.
STORYLINE_INTAKE_MAX_ASSISTANT_TURNS=12
# Text characters an intake transcript may carry into a paid prompt.
STORYLINE_INTAKE_MAX_TRANSCRIPT_CHARS=30000
# Most slides one storyline may hold (dividers excluded). 0 = no cap, as Darwin today.
STORYLINE_MAX_SLIDES=0
# The storyline job: seconds per attempt, and attempts before it is recorded as an error.
STORYLINE_JOB_TIMEOUT_S=600
STORYLINE_JOB_MAX_ATTEMPTS=2

# --- Auth: the bearer tokens Darwin's /api routes accept (app/core/auth.py) --------------
# A JWKS-verified JWT. The real issuer is still open (D7/D8): these name it by config.
# All three are required in production. There is no DEV_SECRET_KEY bypass.
AUTH_ISSUER=
AUTH_AUDIENCE=
# Where the issuer publishes its signing keys (https in production).
AUTH_JWKS_URL=
# Accepted signature algorithms, comma separated (asymmetric only).
AUTH_ALGORITHMS=RS256
# Seconds fetched keys are reused before the JWKS is read again.
AUTH_JWKS_CACHE_S=600
# Clock skew tolerated on exp / nbf / iat, in seconds.
AUTH_LEEWAY_S=30

# Job worker loops run inside the API process; 0 runs none (a separate worker must).
WORKER_CONCURRENCY=0

# --- Darwin's /api (app/config/darwin.py) ---------------------------------------------------
# OpenAI image generation (gpt-image). Empty: image jobs fail. Required in production.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_REQUEST_TIMEOUT_S=180
OPENAI_MAX_RETRIES=3
# Images per UTC day across all users (enforced, as Darwin's reserveImageSlot).
GLOBAL_IMAGES_PER_DAY=400
# Per-user daily caps Darwin defines but never enforces. OFF by default; turning one on
# adds a new 429 (a behaviour change, D12/D33).
INTAKE_CAP_ENABLED=false
INTAKE_TURNS_PER_USER_PER_DAY=120
BRAND_EXTRACT_CAP_ENABLED=false
BRAND_EXTRACTS_PER_USER_PER_DAY=10
